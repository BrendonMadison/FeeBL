# FCC-ee ZH: FSR2025 PA31-3.0 table-derived single-pass input.
# 30 mrad finite crossing, 50% crab waist; no RF crab tilt.
# One million generated macroparticles per beam; 512x1024x64 mesh.
# Recorded backend comparison; numerical convergence is a separate study.
$ACCELERATOR:: fcc_ee_zh_fsr2025
{
  energy=120;
  particles=16.899999999999999;
  charge_sign=-1;
  beta_x=240;
  beta_y=1;
  emitt_x=154.99053373788735;
  emitt_y=0.23483414202710198;
  sigma_z=5590;
  espread=0.0017600000000000001;
  which_espread=3;
  dist_x=0;
  dist_z=0;
  f_rep=3306.8319930123712;
  n_b=300;
  waist_x=0;
  waist_y=0;
  angle_y=0;
  angle_phi=0;
  polar_x=0;
  polar_y=0;
  polar_z=0;
  scale_step=1;
  angle_x.1=0.014999999999999999;
  angle_x.2=0.014999999999999999;
}
$PARAMETERS:: stress
{
  n_z=64;
  n_t=2;
  cut_x=327083.10501636803;
  cut_y=3187.5357880343863;
  cut_z=16770;
  integration_method=2;
  electron_distribution_rho=2;
  force_symmetric=0;
  electron_ratio=1;
  grids=1;
  beam_size=1;
  crab_mode=0;
  crab_full_crossing_angle=0.029999999999999999;
  waist_mode=1;
  waist_fraction=0.5;
  waist_symplecticity_tolerance=1e-10;
  incoming_map_reslice=1;
  load_beam=0;
  store_beam=0;
  rndm_load=0;
  rndm_save=0;
  do_eloss=1;
  do_espread=1;
  do_photons=1;
  store_photons=0;
  photon_ratio=1;
  load_photons=0;
  do_lumi=1;
  num_lumi=50000;
  lumi_p=9.9999999999999994e-30;
  ecm_min=237.59999999999999;
  do_photon_lumi=1;
  electron_lumi_precompute=3;
  electron_lumi_sampling=3;
  electron_lumi_spatial_kernel=0;
  photon_lumi_factorized=1;
  bmt_precession=0;
  ST_spin_flip=0;
  do_bds_spin_rotation=0;
  do_isr=0;
  do_pairs=0;
  beam_pair=0;
  load_events=0;
  do_bhabhas=0;
  track_pairs=0;
  store_pairs=0;
  do_coherent=0;
  do_trident=0;
  do_compt=0;
  do_compt_phot=0;
  do_prod=0;
  do_hadrons=0;
  store_hadrons=0;
  do_jets=0;
  store_jets=0;
  do_muons=0;
  track_muons=0;
  store_muons=0;
  do_cross=0;
  do_tertphot=0;
  do_dump=0;
  store_native=1;
  spectrum_w_min=0;
  spectrum_w_max=264;
  spectrum_w_bins=24000;
  design_axis_spectrum=0;
  ip_dispersion.1=0;
  ip_dispersion.2=0;
  crab_longitudinal_sign.1=1;
  crab_longitudinal_sign.2=-1;
  n_m=1000000;
  n_x=512;
  n_y=1024;
  rndm_seed=72942004;
  collision_schedule="wavefront_parallel";
  wavefront_parallel_physics=1;
  sparse_cells=1;
  wavefront_field_solver="fft";
  cpu_primary_move=0;
  adaptive_grid_mode=0;
  adaptive_macroparticle_mode=0;
  rng_backend="legacy";
  allow_backend_fallback=0;
  compute_backend="cpu";
  cpu_threads=16;
  cpu_variant="pool_dual";
  reduction_mode="strict";
}
