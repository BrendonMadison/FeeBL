num_lumi=50000;
lumi_p=1e-29;
ecm_min=123.75;
do_eloss=1;
do_espread=1;
do_isr=0;
do_photons=1;
store_photons=0;
photon_ratio=1;
do_pairs=0;
load_events=0;
beam_pair=0;
