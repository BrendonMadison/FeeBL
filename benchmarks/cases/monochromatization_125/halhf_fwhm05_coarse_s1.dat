# 125 GeV Higgs-resonance collision study; not a validated accelerator lattice.
# HALHF September 2026 pre-CDR Table 2 Gaussian reconstruction; energies scaled at 9:1; assumed head-on IP
# Charge, normalized emittance, input energy spread, bunch length and rate fixed within family.
$ACCELERATOR:: mono125
{
energy.1=187.5;
particles.1=1;
emitt_x.1=90;
emitt_y.1=0.32;
espread.1=0.0015;
energy.2=20.8333333333333;
particles.2=3;
emitt_x.2=10;
emitt_y.2=0.035;
espread.2=0.0015;
charge_sign=-1;
beta_x=0.825;
beta_y=0.1;
sigma_z=150;
which_espread=3;
dist_z=0;
f_rep=100;
n_b=160;
waist_x=0;
waist_y=75;
angle_y=0;
angle_phi=0;
polar_x=0;
polar_y=0;
polar_z=0;
scale_step=1;
angle_x.1=0;
angle_x.2=0;
}
$PARAMETERS:: diagnostic
{
waist_symplecticity_tolerance=1e-10;
incoming_map_reslice=1;
compute_backend="gpu";
allow_backend_fallback=0;
collision_schedule="wavefront_parallel";
