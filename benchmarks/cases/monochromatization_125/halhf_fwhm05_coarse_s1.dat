spectrum_w_bins=2048;
design_axis_spectrum=1;
design_axis_peak_bins=800000;
ip_dispersion.1=0.18725773876900906;
ip_dispersion.2=-0.18725773876900906;
crab_longitudinal_sign.1=1;
crab_longitudinal_sign.2=-1;
