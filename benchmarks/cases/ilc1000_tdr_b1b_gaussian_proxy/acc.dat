# ILC 1 TeV Gaussian incoming-beam approximation; FCAL 2014 Fig. 49.
$ACCELERATOR:: ilc1000
{energy.1=500;energy.2=500;particles.1=1.74;particles.2=1.74;charge_sign=-1;
beta_x=11;beta_y=0.23;emitt_x=10;emitt_y=0.03;sigma_z=225;
espread.1=0.00085;espread.2=0.00047;which_espread=3;dist_z=0;f_rep=4;n_b=2450;waist_x=0;waist_y=0;
polar_x=0;polar_y=0;polar_z.1=0;polar_z.2=0;angle_x=0;angle_y=0;angle_phi=0;}
$PARAMETERS:: diagnostic
{compute_backend="serial";allow_backend_fallback=0;collision_schedule="legacy";
wavefront_field_solver="fft";n_x=128;n_y=128;n_z=32;n_t=2;n_m=10000;
cut_x=2011.74344388;cut_y=31.86623783;cut_z=3.5*sigma_z.1;
integration_method=2;force_symmetric=0;electron_ratio=1;
rndm_seed=6102724;rndm_load=0;rndm_save=0;load_beam=0;store_beam=0;
bmt_precession=0;ST_spin_flip=0;do_lumi=1;num_lumi=50000;lumi_p=1e-29;
ecm_min=990;do_eloss=1;do_espread=1;do_isr=0;
do_photons=1;store_photons=0;photon_ratio=1;
do_pairs=0;load_events=0;beam_pair=0;do_bhabhas=0;store_pairs=0;pair_ratio=1;pair_q2=2;track_pairs=0;pair_ecut=0.005;
do_coherent=0;do_trident=0;do_compt=0;compt_emax=550;compt_x_min=0.01;
do_hadrons=0;store_hadrons=0;do_jets=0;store_jets=0;do_muons=0;
grids=3;beam_size=1;crab_mode=0;crab_full_crossing_angle=0;crab_longitudinal_sign.1=1;crab_longitudinal_sign.2=-1;waist_mode=0;
store_native=1;spectrum_w_min=0;spectrum_w_max=1020;spectrum_w_bins=20400;hist_ee_bins=2040;hist_ee_max=1020;}
