# 250 GeV field-free Gaussian overlap; zero horizontal dispersion.
$ACCELERATOR:: mono_geometry
{energy.1=125;energy.2=125;particles.1=2;particles.2=2;
charge_sign=0;
beta_x=130000;beta_y=4100;emitt_x=0.0005;emitt_y=0.0000035;
sigma_z=300;espread.1=0.0015;espread.2=0.0015;
which_espread.1=3;which_espread.2=3;dist_x=0;dist_z=0;
f_rep=1;n_b=1;offset_x=0;offset_y=0;offset_z=0;waist_x=0;waist_y=0;
angle_x=0;angle_y=0;angle_phi=0;}
$PARAMETERS:: diagnostic
{compute_backend="serial";allow_backend_fallback=0;collision_schedule="legacy";
n_x=256;n_y=128;n_z=16;n_t=2;n_m=20000;
cut_x=6000;cut_y=80;cut_z=1500;
integration_method=2;electron_distribution_rho=2;
automatic_grid_sizing=0;optimize_grids=0;force_symmetric=0;electron_ratio=1;
rndm_seed=6102631;rndm_load=0;rndm_save=0;
load_beam=0;store_beam=1;do_lumi=1;num_lumi=50000;lumi_p=1e-29;
ecm_min=245;do_eloss=0;do_espread=1;do_isr=0;
do_photons=0;store_photons=0;
do_pairs=0;track_pairs=0;store_pairs=0;do_muons=0;track_muons=0;store_muons=0;
do_coherent=0;do_trident=0;do_compt=0;do_hadrons=0;store_hadrons=0;
do_jets=0;store_jets=0;do_bhabhas=0;do_cross=0;do_prod=0;load_events=0;
bmt_precession=0;ST_spin_flip=0;grids=1;beam_size=1;scale_step=1;
crab_mode=0;waist_mode=0;crab_full_crossing_angle=0;
crab_longitudinal_sign.1=1;crab_longitudinal_sign.2=-1;
crab_include_panofsky_wenzel=1;waist_symplecticity_tolerance=1e-9;
ip_dispersion.1=0.00000000;ip_dispersion.2=0.00000000;
store_native=1;spectrum_w_min=247;spectrum_w_max=253;spectrum_w_bins=1200;
hist_ee_bins=1200;hist_ee_max=253;}
