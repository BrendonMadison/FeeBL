# HALHF 250 GeV incoherent-only population control; Gaussian incoming beams.
$ACCELERATOR:: halhf250
{
energy.1=375;energy.2=41.7;
particles.1=1;particles.2=3;charge_sign=-1;
beta_x=3.3;beta_y=0.1;
emitt_x.1=90;emitt_y.1=0.32;emitt_x.2=10;emitt_y.2=0.035;
sigma_z=150;espread=0.0015;which_espread=3;dist_z=0;
f_rep=100;n_b=160;waist_x=0;waist_y=75;
angle_x.1=0;angle_x.2=0;angle_y=0;angle_phi=0;
}
$PARAMETERS:: diagnostic
{
compute_backend="serial";allow_backend_fallback=0;collision_schedule="legacy";
wavefront_field_solver="fft";
n_x=128;n_y=128;n_z=32;n_t=2;n_m=10000;
cut_x=2544.67654023;cut_y=26.413706664;cut_z=3*sigma_z.1;
integration_method=2;force_symmetric=0;electron_ratio=1;
rndm_seed=73052005;rndm_load=0;rndm_save=0;
load_beam=0;store_beam=0;
do_lumi=1;num_lumi=50000;lumi_p=1e-29;ecm_min=247.5;
do_eloss=1;do_espread=1;do_isr=1;
do_photons=1;store_photons=0;photon_ratio=1;
do_pairs=1;store_pairs=2;pair_ratio=0.1;pair_q2=2;track_pairs=1;pair_ecut=0.0005;
do_coherent=0;do_trident=0;do_compt=0;compt_emax=412.5;compt_x_min=0.01;
do_hadrons=0;store_hadrons=0;do_jets=0;store_jets=0;do_muons=0;
grids=7;beam_size=3;crab_mode=0;waist_mode=0;
store_native=1;spectrum_w_min=0;spectrum_w_max=255;spectrum_w_bins=1020;
hist_ee_bins=1020;hist_ee_max=255;

photon_timing=3;

photon_angle=2;

photon_polarisation=1;

coherent_model=1;

do_photon_lumi=1;

beam_pair=0;

load_events=0;

do_bhabhas=0;

pair_model=2;
}
