# HALHF 380 GeV Gaussian incoming beams; September 2026 Pre-CDR.
$ACCELERATOR:: halhf380
{
energy.1=570;energy.2=63.3;
particles.1=1;particles.2=3;charge_sign=-1;
beta_x=3.3;beta_y=0.1;
emitt_x.1=90;emitt_y.1=0.32;emitt_x.2=10;emitt_y.2=0.035;
sigma_z=150;espread=0.0015;which_espread=3;dist_z=0;
f_rep=100;n_b=160;waist_x=0;waist_y=75;
angle_x.1=0;angle_x.2=0;angle_y=0;angle_phi=0;
}
$PARAMETERS:: diagnostic
{
compute_backend="serial";allow_backend_fallback=0;collision_schedule="legacy";
wavefront_field_solver="fft";
n_x=128;n_y=128;n_z=32;n_t=2;n_m=10000;
cut_x=2064.00522337;cut_y=21.4243451618;cut_z=3*sigma_z.1;
integration_method=2;force_symmetric=0;electron_ratio=1;
rndm_seed=6102702;rndm_load=0;rndm_save=0;
load_beam=0;store_beam=0;
do_lumi=1;num_lumi=50000;lumi_p=1e-29;ecm_min=376.2;
do_eloss=1;do_espread=1;do_isr=1;
do_photons=1;store_photons=1;photon_ratio=1;
do_pairs=1;store_pairs=1;pair_ratio=0.1;pair_q2=2;track_pairs=1;pair_ecut=0.0005;
do_coherent=1;do_trident=0;do_compt=1;compt_emax=627;compt_x_min=0.01;
do_hadrons=0;store_hadrons=0;do_jets=0;store_jets=0;do_muons=0;
grids=7;beam_size=1;crab_mode=0;waist_mode=0;
store_native=1;spectrum_w_min=0;spectrum_w_max=387.6;spectrum_w_bins=1550;
hist_ee_bins=1550;hist_ee_max=387.6;
}
