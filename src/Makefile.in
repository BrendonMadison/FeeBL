clean :

	rm -f $(MODULES) feebl feeblroot

incomingMapsCPP.o: incomingMapsCPP.cc incomingMapsCPP.h canonicalBunchCPP.h 	gpgeom/maps.hpp gpgeom/phase_space.hpp
gpgeomMaps.o: gpgeomMaps.cc gpgeom/maps.hpp gpgeom/phase_space.hpp
