gpuCicStub.o: gpuCicStub.cc gpuCic.h

gpuResidentStub.o: gpuResidentStub.cc gpuResident.h

parallelBackendCPP.o: parallelBackendCPP.cc parallelBackendCPP.h

legacyPhotonLumiFastCPP.o: legacyPhotonLumiFastCPP.cc legacyPhotonLumiFastCPP.h
	$(CXX) $(CFLAGS) $(CXXFLAGS) $(OPENMP_CXXFLAGS) -fno-fast-math $< -c -o $@

legacyElectronLumiBlockedCPP.o: legacyElectronLumiBlockedCPP.cc \
  legacyElectronLumiBlockedCPP.h
	$(CXX) $(CFLAGS) $(CXXFLAGS) $(OPENMP_CXXFLAGS) $< -c -o $@

fourierCPP.o: config.h fourierCPP.cc fourierCPP.h

fieldCPP.o: config.h fieldCPP.cc fieldCPP.h typeDefs.h define.h mathconst.h \
