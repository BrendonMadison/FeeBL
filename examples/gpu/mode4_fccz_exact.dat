gpu2_primary_mover="serial";gpu2_memory_fraction=0.80;
gpu2_profile="summary";reduction_mode="fast";allow_backend_fallback=0;
collision_schedule="wavefront_parallel";sparse_cells=1;
wavefront_field_solver="fft";
electron_lumi_precompute=0;photon_lumi_factorized=1;
n_x=128;n_y=256;n_z=160;
n_t=1;n_m=25000;
cut_x=1389005.7;cut_y=4096.62;cut_z=3.0*sigma_z.1;
