grids=1;rndm_load=0;rndm_save=0;rndm_seed=2;
load_beam=0;charge_sign=-1.0;do_espread=1;
waist_mode=1;waist_fraction=1.0;
crab_full_crossing_angle=0.03;
crab_longitudinal_sign.1=1;crab_longitudinal_sign.2=-1;
waist_symplecticity_tolerance=1e-9;
store_native=1;do_lumi=1;num_lumi=50000;
ip_dispersion.1=0.002797928;ip_dispersion.2=-0.002797928;
