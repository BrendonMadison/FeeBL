$ACCELERATOR:: tiny
{energy=45.6;particles=2.0;
beta_x=25.0;beta_y=0.8;
emitt_x=63.0;emitt_y=0.13;
sigma_z=453.125;espread=0.0026;dist_z=0;
f_rep=3288.131;n_b=10000;waist_y=0;
angle_x.1=0.015;angle_x.2=0.015;
angle_phi.1=0.0;angle_phi.2=0.0;}

$PARAMETERS:: exact
{n_x=64;n_y=64;n_z=8;n_t=1;n_m=2000;
cut_x=1389005.7;cut_y=4096.62;cut_z=3.0*sigma_z.1;
force_symmetric=0;electron_ratio=1.0;
do_eloss=1;ST_spin_flip=0;bmt_precession=0;
do_photons=1;store_photons=0;do_photon_lumi=1;photon_ratio=1.0;
photon_lumi_factorized=1;
do_lumi=1;num_lumi=1000;do_isr=0;do_cross=0;do_bhabhas=0;
do_hadrons=0;store_hadrons=0;do_jets=0;
do_pairs=0;track_pairs=0;store_pairs=0;
do_compt=0;do_compt_phot=0;do_muons=0;track_muons=0;
do_coherent=0;do_trident=0;do_prod=0;do_tertphot=0;
grids=1;integration_method=2;rndm_seed=424242;rndm_load=0;rndm_save=1;
load_beam=0;load_photons=0;store_beam=1;store_native=1;
charge_sign=-1.0;ecm_min=1.98*energy.1;ecm_min_gg=1.0;
spectrum_w_min=44.0;spectrum_w_max=47.0;spectrum_w_bins=300;
hist_ee_bins=200;hist_ee_max=2.02*energy.1;
do_dump=1;dump_step=2;dump_particle=7;
collision_schedule="legacy";}
