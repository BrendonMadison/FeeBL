$ACCELERATOR:: fccz
{energy=45.6;particles=24.3000;
beta_x=25;beta_y=0.8;
emitt_x=63.0;emitt_y=0.13;
sigma_z=226.562500;espread.1=0.0026;espread.2=0.0026;
which_espread.1=3;which_espread.2=3;dist_z=0;
f_rep=3288.131;n_b=10000;waist_y=0;
angle_x.1=0.0;angle_x.2=0.0;
angle_phi.1=0.0;angle_phi.2=0.0;}

$PARAMETERS:: p_fccz
{compute_backend="cpu";cpu_threads=2;cpu_variant="pool_dual";
reduction_mode="strict";allow_backend_fallback=0;
electron_lumi_precompute=3;electron_lumi_sampling=1;
photon_lumi_factorized=1;wavefront_parallel_physics=1;
sparse_cells=1;collision_schedule="wavefront_parallel";
wavefront_field_solver="fft";sparse_direct_interaction_limit=262144;
# ADAPTIVE_GRID_OPTIONS
n_x=32;n_y=32;n_z=8;
n_t=1;n_m=256;
cut_x=1389005.7;cut_y=4096.62;cut_z=3.0*sigma_z.1;
force_symmetric=0;electron_ratio=1.0;
do_photons=0;store_photons=0;photon_ratio=1.0;
ecm_min=1.98*energy.1;
do_hadrons=0;store_hadrons=0;do_coherent=0;do_trident=0;
do_pairs=0;track_pairs=0;store_pairs=0;do_compt=0;do_muons=0;
grids=1;rndm_load=0;rndm_save=0;rndm_seed=17;
load_beam=0;charge_sign=-1.0;
do_espread=1;store_native=1;do_lumi=1;num_lumi=512;
spectrum_w_min=84.0;spectrum_w_max=92.0;spectrum_w_bins=160;}
