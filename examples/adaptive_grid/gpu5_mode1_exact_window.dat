angle_phi.1=0.0;angle_phi.2=0.0;}

$PARAMETERS:: p_fccz
{compute_backend="gpu";cpu_threads=0;cpu_variant="auto";
cpu_primary_move=0;gpu_variant="auto";gpu_device=0;
gpu_min_particles=262144;gpu_mode=5;
gpu2_scope="primary";gpu2_deposition="atomic";gpu2_fft="cufft";
gpu2_streams=1;gpu2_graphs="off";gpu2_fusion="on";
gpu2_batch_slices=16;gpu2_pinned_io="on";
