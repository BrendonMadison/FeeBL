adaptive_grid_schedule_save="gpu5.schedule.ag1";
adaptive_grid_profile="summary";
n_x=128;n_y=256;n_z=16;
n_t=1;n_m=1000;
cut_x=1389005.7;cut_y=4096.62;cut_z=3.0*sigma_z.1;
